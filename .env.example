# Copie este arquivo para ".env" (sem o ".example") e preencha com seus valores reais.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub (o .gitignore já cuida disso).
# Em produção (GitHub Actions), esses mesmos valores ficam guardados em "GitHub Secrets",
# não neste arquivo.

# Token do seu bot do Telegram (obtido com o @BotFather)
TELEGRAM_BOT_TOKEN=

# ID do chat/canal do Telegram para onde as mensagens serão enviadas
TELEGRAM_CHAT_ID=

# Conteúdo do arquivo JSON de credenciais da conta de serviço do Google
# (gerado no Google Cloud Console). Cole o JSON inteiro em uma linha só.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Nome (título) da planilha do Google Sheets onde tudo será salvo
GOOGLE_SHEET_NAME=
